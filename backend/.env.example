# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma7.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

PORT=5000

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/laundrify"

JWT_SECRET="my-secret"
JWT_EXPIRES_IN="1d"
# Google Identity Services
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# URL aplikasi customer (folder customer/) - Midtrans mengarahkan customer ke sini setelah bayar
CUSTOMER_URL=http://localhost:5174
# Opsional: origin yang boleh konek WebSocket (web admin + app customer), pisahkan dengan koma.
# Kosong = semua origin. Bila dibuka dari HP lewat IP laptop, tambahkan origin itu juga.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Midtrans. Ambil dari Dashboard Midtrans > Settings > Access Keys, pada lingkungan (Environment) yang Anda pakai.
# Salin PERSIS seperti di dashboard: tanpa tanda kutip, tanpa spasi, dan JANGAN menambah/menghapus awalan apa pun.
# Awalan key bisa berbeda antar akun (mis. SB-Mid-server-... atau Mid-server-...).
# Environment Sandbox (uji coba) -> MIDTRANS_IS_PRODUCTION=false ; Production (uang asli) -> true
# WAJIB restart backend setelah mengubah file .env.
MIDTRANS_IS_PRODUCTION=false)
# Production: key diawali Mid-server- / Mid-client-      (MIDTRANS_IS_PRODUCTION=true)
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=isi-dengan-server-key-dari-dashboard-midtrans
MIDTRANS_CLIENT_KEY=isi-dengan-client-key-dari-dashboard-midtrans
