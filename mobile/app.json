{
  "expo": {
    "name": "Laundrify Staff",
    "slug": "laundrify-staff",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "laundrify",
    "assetBundlePatterns": ["**/*"],
    "plugins": ["expo-secure-store", "expo-notifications"],
    "android": {
      "package": "com.laundrify.staff",
      "permissions": ["POST_NOTIFICATIONS"],
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "bundleIdentifier": "com.laundrify.staff"
    }
  }
}
